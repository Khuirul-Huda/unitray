# Maintainer: Khuirul Huda <hello@khuirulhuda.my.id>
pkgname=unitray
pkgver=0.1.0
pkgrel=1
pkgdesc="Lightweight systemd service manager in your Linux system tray"
arch=('x86_64' 'aarch64')
url="https://github.com/Khuirul-Huda/unitray"
license=('MIT')
depends=('systemd')
makedepends=('rust' 'cargo')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm755 "scripts/$pkgname-settings" "$pkgdir/usr/bin/$pkgname-settings"
    install -Dm644 "data/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 "data/$pkgname.service" "$pkgdir/usr/lib/systemd/user/$pkgname.service"
    install -Dm644 "data/49-$pkgname.rules" "$pkgdir/usr/share/polkit-1/rules.d/49-$pkgname.rules"
    install -Dm644 "config/$pkgname.toml" "$pkgdir/etc/$pkgname/config.toml"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
