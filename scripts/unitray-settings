#!/usr/bin/env python3
"""
Unitray Settings - Native Qt 6 Configuration Utility for Unitray
Discovers all systemd services with interactive enable/disable checkboxes.
"""

import sys
import subprocess
import tomllib
from pathlib import Path

from PySide6.QtCore import Qt, QTimer
from PySide6.QtGui import QIcon, QFont, QColor
from PySide6.QtWidgets import (
    QApplication,
    QDialog,
    QVBoxLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QTableWidget,
    QTableWidgetItem,
    QHeaderView,
    QSpinBox,
    QLineEdit,
    QGroupBox,
    QFormLayout,
    QMessageBox,
    QTabWidget,
    QWidget,
    QCheckBox,
    QSplitter,
    QCompleter,
)

CONFIG_DIR = Path.home() / ".config" / "unitray"
CONFIG_PATH = CONFIG_DIR / "config.toml"

DEFAULT_CONFIG = {
    "refresh_interval_secs": 3,
    "tray_icon": "preferences-system-services",
    "services": [
        {"name": "MariaDB", "unit": "mariadb.service"},
        {"name": "PostgreSQL", "unit": "postgresql.service"},
        {"name": "Docker", "unit": "docker.service"},
        {"name": "Cloudflare Tunnel", "unit": "cloudflared.service"},
    ],
}


def query_systemd_services():
    """Query all available systemd services on the system."""
    services = {}

    # 1. Discover all service unit files
    res = subprocess.run(
        ["systemctl", "list-unit-files", "--type=service", "--no-legend", "--no-pager"],
        capture_output=True,
        text=True,
        check=False,
    )
    for line in res.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            unit = parts[0]
            if "@" in unit and not unit.endswith("@.service"):
                continue
            services[unit] = {"unit": unit, "state": "inactive", "desc": ""}

    # 2. Get active statuses and descriptions
    res2 = subprocess.run(
        ["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--no-pager"],
        capture_output=True,
        text=True,
        check=False,
    )
    for line in res2.stdout.splitlines():
        parts = line.split(maxsplit=4)
        if len(parts) >= 4:
            unit = parts[0].replace("●", "").strip()
            active_state = parts[2]
            desc = parts[4] if len(parts) == 5 else ""
            if unit in services:
                services[unit]["state"] = active_state
                services[unit]["desc"] = desc
            else:
                services[unit] = {"unit": unit, "state": active_state, "desc": desc}

    return services


def load_config():
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "rb") as f:
                data = tomllib.load(f)
                return {
                    "refresh_interval_secs": data.get("refresh_interval_secs", 3),
                    "tray_icon": data.get("tray_icon", "preferences-system-services"),
                    "services": data.get("services", []),
                }
        except Exception as e:
            QMessageBox.warning(None, "Warning", f"Failed to parse config, using defaults:\n{e}")
    return DEFAULT_CONFIG.copy()


def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Unitray Configuration",
        "# Auto-generated by Unitray Settings",
        "",
        f"refresh_interval_secs = {int(config['refresh_interval_secs'])}",
        f'tray_icon = "{config["tray_icon"].strip()}"',
        "",
    ]
    for s in config["services"]:
        lines.append("[[services]]")
        lines.append(f'name = "{s["name"].strip()}"')
        lines.append(f'unit = "{s["unit"].strip()}"')
        lines.append("")

    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


class ServiceEditDialog(QDialog):
    def __init__(self, parent=None, title="Custom Service", name="", unit="", available_units=None):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setMinimumWidth(440)
        self.available_units = available_units or []

        layout = QVBoxLayout(self)
        form = QFormLayout()

        # systemd Unit first, so autocomplete guides the user!
        self.unit_edit = QLineEdit(unit)
        self.unit_edit.setPlaceholderText("Type to search systemd services (e.g. docker.service, mariadb)...")

        if self.available_units:
            completer = QCompleter(sorted(self.available_units), self)
            completer.setCaseSensitivity(Qt.CaseInsensitive)
            completer.setFilterMode(Qt.MatchContains)
            completer.setMaxVisibleItems(10)
            self.unit_edit.setCompleter(completer)

        form.addRow("systemd Unit:", self.unit_edit)

        self.name_edit = QLineEdit(name)
        self.name_edit.setPlaceholderText("e.g. Docker Engine")
        form.addRow("Display Name:", self.name_edit)

        hint_label = QLabel("<small style='color: #888888;'>💡 <i>Start typing in 'systemd Unit' to see live autocomplete suggestions from your system.</i></small>")
        hint_label.setTextFormat(Qt.RichText)
        form.addRow("", hint_label)

        layout.addLayout(form)

        # Auto-fill display name when unit is selected
        self.last_auto_name = ""
        self.unit_edit.textChanged.connect(self.on_unit_text_changed)

        btn_box = QHBoxLayout()
        btn_box.addStretch()

        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        btn_box.addWidget(cancel_btn)

        save_btn = QPushButton("Save")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self.validate_and_accept)
        btn_box.addWidget(save_btn)

        layout.addLayout(btn_box)

    def on_unit_text_changed(self, text):
        clean_name = text.strip()
        for ext in [".service", ".socket", ".target", ".timer"]:
            if clean_name.endswith(ext):
                clean_name = clean_name[:-len(ext)]
        clean_name = clean_name.replace("-", " ").replace("_", " ").title()

        current_name = self.name_edit.text()
        if not current_name or current_name == self.last_auto_name:
            self.name_edit.setText(clean_name)
            self.last_auto_name = clean_name

    def validate_and_accept(self):
        name = self.name_edit.text().strip()
        unit = self.unit_edit.text().strip()

        if not name:
            QMessageBox.warning(self, "Invalid Input", "Please enter a display name.")
            return
        if not unit:
            QMessageBox.warning(self, "Invalid Input", "Please enter a valid systemd unit name.")
            return

        if not any(unit.endswith(ext) for ext in [".service", ".socket", ".target", ".timer"]):
            unit = f"{unit}.service"

        self.name = name
        self.unit = unit
        self.accept()


class UnitraySettingsWindow(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Unitray Settings — Systemd Service Controller")
        self.setWindowIcon(QIcon.fromTheme("preferences-system-services"))
        self.resize(750, 600)

        self.config_data = load_config()
        self.all_services = query_systemd_services()

        # Track monitored units in an ordered list: [{"name": ..., "unit": ...}]
        self.monitored_services = list(self.config_data.get("services", []))

        layout = QVBoxLayout(self)
        layout.setSpacing(10)

        # Tab Widget
        self.tabs = QTabWidget()
        layout.addWidget(self.tabs)

        # Tab 1: Monitored Services (In Tray)
        self.tab_monitored = QWidget()
        self.init_monitored_tab()
        self.tabs.addTab(self.tab_monitored, QIcon.fromTheme("favorite"), "Monitored in Tray")

        # Tab 2: System Service Explorer
        self.tab_explorer = QWidget()
        self.init_explorer_tab()
        self.tabs.addTab(self.tab_explorer, QIcon.fromTheme("system-search"), f"All System Services ({len(self.all_services)})")

        # Tab 3: General Settings
        self.tab_general = QWidget()
        self.init_general_tab()
        self.tabs.addTab(self.tab_general, QIcon.fromTheme("configure"), "General Options")

        # Bottom Action Bar
        bottom_bar = QHBoxLayout()

        editor_btn = QPushButton(QIcon.fromTheme("document-edit"), "Open Config in Text Editor")
        editor_btn.clicked.connect(self.open_in_editor)
        bottom_bar.addWidget(editor_btn)

        bottom_bar.addStretch()

        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        bottom_bar.addWidget(cancel_btn)

        save_btn = QPushButton(QIcon.fromTheme("dialog-ok-apply"), "💾 Save & Apply")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self.save_and_apply)
        bottom_bar.addWidget(save_btn)

        layout.addLayout(bottom_bar)

    def init_monitored_tab(self):
        layout = QVBoxLayout(self.tab_monitored)
        layout.setContentsMargins(12, 12, 12, 12)

        info_label = QLabel(
            "These services will appear in your top panel system tray. "
            "Use the Up/Down buttons to reorder how they are displayed."
        )
        info_label.setWordWrap(True)
        layout.addWidget(info_label)

        self.monitored_table = QTableWidget(0, 3)
        self.monitored_table.setHorizontalHeaderLabels(["Display Name", "systemd Unit", "Current Status"])
        self.monitored_table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeToContents)
        self.monitored_table.horizontalHeader().setSectionResizeMode(1, QHeaderView.Stretch)
        self.monitored_table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeToContents)
        self.monitored_table.setSelectionBehavior(QTableWidget.SelectRows)
        self.monitored_table.setSelectionMode(QTableWidget.SingleSelection)
        self.monitored_table.setAlternatingRowColors(True)
        layout.addWidget(self.monitored_table)

        btn_bar = QHBoxLayout()

        add_custom_btn = QPushButton(QIcon.fromTheme("list-add"), "Add Custom Unit...")
        add_custom_btn.clicked.connect(self.add_custom_service)
        btn_bar.addWidget(add_custom_btn)

        edit_btn = QPushButton(QIcon.fromTheme("edit-entry"), "Edit Name...")
        edit_btn.clicked.connect(self.edit_monitored_name)
        btn_bar.addWidget(edit_btn)

        remove_btn = QPushButton(QIcon.fromTheme("list-remove"), "Remove from Tray")
        remove_btn.clicked.connect(self.remove_monitored_service)
        btn_bar.addWidget(remove_btn)

        btn_bar.addStretch()

        up_btn = QPushButton(QIcon.fromTheme("go-up"), "Up")
        up_btn.clicked.connect(self.move_up)
        btn_bar.addWidget(up_btn)

        down_btn = QPushButton(QIcon.fromTheme("go-down"), "Down")
        down_btn.clicked.connect(self.move_down)
        btn_bar.addWidget(down_btn)

        layout.addLayout(btn_bar)
        self.populate_monitored_table()

    def init_explorer_tab(self):
        layout = QVBoxLayout(self.tab_explorer)
        layout.setContentsMargins(12, 12, 12, 12)

        # Search Bar
        search_box = QHBoxLayout()
        search_label = QLabel("🔍 Search Services:")
        search_box.addWidget(search_label)

        self.search_input = QLineEdit()
        self.search_input.setPlaceholderText("Filter by name (e.g. docker, maria, redis, postgres, nginx, cloudflare)...")
        self.search_input.setClearButtonEnabled(True)
        self.search_input.textChanged.connect(self.filter_explorer_table)
        search_box.addWidget(self.search_input)

        layout.addLayout(search_box)

        # Explorer Table
        self.explorer_table = QTableWidget(0, 4)
        self.explorer_table.setHorizontalHeaderLabels(["Monitor in Tray", "Unit Name", "Status", "Description"])
        self.explorer_table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeToContents)
        self.explorer_table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        self.explorer_table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeToContents)
        self.explorer_table.horizontalHeader().setSectionResizeMode(3, QHeaderView.Stretch)
        self.explorer_table.setSelectionBehavior(QTableWidget.SelectRows)
        self.explorer_table.setAlternatingRowColors(True)
        layout.addWidget(self.explorer_table)

        self.populate_explorer_table()

    def init_general_tab(self):
        layout = QVBoxLayout(self.tab_general)
        layout.setContentsMargins(16, 16, 16, 16)

        opts_group = QGroupBox("General Options")
        form = QFormLayout(opts_group)

        self.interval_spin = QSpinBox()
        self.interval_spin.setRange(1, 60)
        self.interval_spin.setSuffix(" seconds")
        self.interval_spin.setValue(self.config_data.get("refresh_interval_secs", 3))
        form.addRow("Status Refresh Polling Interval:", self.interval_spin)

        self.icon_edit = QLineEdit(self.config_data.get("tray_icon", "preferences-system-services"))
        form.addRow("System Tray Icon Theme Name:", self.icon_edit)

        layout.addWidget(opts_group)
        layout.addStretch()

    def populate_monitored_table(self):
        self.monitored_table.setRowCount(0)
        for s in self.monitored_services:
            unit = s.get("unit", "")
            name = s.get("name", unit.replace(".service", "").capitalize())
            info = self.all_services.get(unit, {})
            state = info.get("state", "unknown")

            row = self.monitored_table.rowCount()
            self.monitored_table.insertRow(row)

            # Name Item
            name_item = QTableWidgetItem(name)
            self.monitored_table.setItem(row, 0, name_item)

            # Unit Item
            unit_item = QTableWidgetItem(unit)
            unit_item.setFlags(unit_item.flags() & ~Qt.ItemIsEditable)
            self.monitored_table.setItem(row, 1, unit_item)

            # Status Item
            status_str = "🟢 Active" if state == "active" else "🔴 Inactive"
            status_item = QTableWidgetItem(status_str)
            status_item.setFlags(status_item.flags() & ~Qt.ItemIsEditable)
            self.monitored_table.setItem(row, 2, status_item)

    def populate_explorer_table(self):
        self.explorer_table.setRowCount(0)
        monitored_units = {s["unit"] for s in self.monitored_services}

        # Sort services: monitored ones first, then alphabetical
        sorted_units = sorted(
            self.all_services.keys(),
            key=lambda u: (0 if u in monitored_units else 1, u.lower())
        )

        for unit in sorted_units:
            info = self.all_services[unit]
            state = info.get("state", "inactive")
            desc = info.get("desc", "")
            is_monitored = unit in monitored_units

            row = self.explorer_table.rowCount()
            self.explorer_table.insertRow(row)

            # Checkbox item for "Monitor in Tray"
            check_item = QTableWidgetItem()
            check_item.setFlags(Qt.ItemIsUserCheckable | Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            check_item.setCheckState(Qt.Checked if is_monitored else Qt.Unchecked)
            check_item.setTextAlignment(Qt.AlignCenter)
            self.explorer_table.setItem(row, 0, check_item)

            # Unit Name
            unit_item = QTableWidgetItem(unit)
            unit_item.setFlags(Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            self.explorer_table.setItem(row, 1, unit_item)

            # Status
            status_str = "🟢 Active" if state == "active" else "🔴 Inactive"
            status_item = QTableWidgetItem(status_str)
            status_item.setFlags(Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            self.explorer_table.setItem(row, 2, status_item)

            # Description
            desc_item = QTableWidgetItem(desc)
            desc_item.setFlags(Qt.ItemIsEnabled | Qt.ItemIsSelectable)
            self.explorer_table.setItem(row, 3, desc_item)

        self.explorer_table.itemChanged.connect(self.on_explorer_checkbox_changed)

    def filter_explorer_table(self, query):
        query = query.strip().lower()
        for r in range(self.explorer_table.rowCount()):
            unit = self.explorer_table.item(r, 1).text().lower()
            desc = self.explorer_table.item(r, 3).text().lower()
            match = query in unit or query in desc
            self.explorer_table.setRowHidden(r, not match)

    def on_explorer_checkbox_changed(self, item):
        if item.column() != 0:
            return

        row = item.row()
        unit = self.explorer_table.item(row, 1).text()
        is_checked = item.checkState() == Qt.Checked

        monitored_units = [s["unit"] for s in self.monitored_services]

        if is_checked and unit not in monitored_units:
            # Generate clean display name
            display_name = unit.replace(".service", "").replace("-", " ").title()
            self.monitored_services.append({"name": display_name, "unit": unit})
            self.populate_monitored_table()
        elif not is_checked and unit in monitored_units:
            self.monitored_services = [s for s in self.monitored_services if s["unit"] != unit]
            self.populate_monitored_table()

    def add_custom_service(self):
        units = list(self.all_services.keys())
        dlg = ServiceEditDialog(self, title="Add Custom systemd Unit", available_units=units)
        if dlg.exec() == QDialog.Accepted:
            self.monitored_services.append({"name": dlg.name, "unit": dlg.unit})
            self.populate_monitored_table()
            # Update explorer checkbox if present
            self.update_explorer_checkboxes()

    def edit_monitored_name(self):
        row = self.monitored_table.currentRow()
        if row < 0:
            QMessageBox.information(self, "Notice", "Please select a service to edit its display name.")
            return

        current_name = self.monitored_table.item(row, 0).text()
        unit = self.monitored_table.item(row, 1).text()
        units = list(self.all_services.keys())

        dlg = ServiceEditDialog(self, title="Edit Display Name", name=current_name, unit=unit, available_units=units)
        if dlg.exec() == QDialog.Accepted:
            self.monitored_services[row]["name"] = dlg.name
            self.populate_monitored_table()

    def remove_monitored_service(self):
        row = self.monitored_table.currentRow()
        if row < 0:
            QMessageBox.information(self, "Notice", "Please select a service to remove.")
            return

        name = self.monitored_services[row]["name"]
        unit = self.monitored_services[row]["unit"]

        del self.monitored_services[row]
        self.populate_monitored_table()
        self.update_explorer_checkboxes()

    def update_explorer_checkboxes(self):
        monitored_units = {s["unit"] for s in self.monitored_services}
        self.explorer_table.blockSignals(True)
        for r in range(self.explorer_table.rowCount()):
            unit = self.explorer_table.item(r, 1).text()
            self.explorer_table.item(r, 0).setCheckState(
                Qt.Checked if unit in monitored_units else Qt.Unchecked
            )
        self.explorer_table.blockSignals(False)

    def move_up(self):
        row = self.monitored_table.currentRow()
        if row > 0:
            self.monitored_services[row], self.monitored_services[row - 1] = (
                self.monitored_services[row - 1],
                self.monitored_services[row],
            )
            self.populate_monitored_table()
            self.monitored_table.selectRow(row - 1)

    def move_down(self):
        row = self.monitored_table.currentRow()
        if 0 <= row < len(self.monitored_services) - 1:
            self.monitored_services[row], self.monitored_services[row + 1] = (
                self.monitored_services[row + 1],
                self.monitored_services[row],
            )
            self.populate_monitored_table()
            self.monitored_table.selectRow(row + 1)

    def open_in_editor(self):
        import os
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if not CONFIG_PATH.exists():
            save_config(self.config_data)
        os.system(f"xdg-open '{CONFIG_PATH}' &")

    def save_and_apply(self):
        # Sync any edited name cells from table
        for r in range(self.monitored_table.rowCount()):
            name = self.monitored_table.item(r, 0).text().strip()
            if r < len(self.monitored_services):
                self.monitored_services[r]["name"] = name

        new_config = {
            "refresh_interval_secs": self.interval_spin.value(),
            "tray_icon": self.icon_edit.text().strip() or "preferences-system-services",
            "services": self.monitored_services,
        }

        try:
            save_config(new_config)
            QMessageBox.information(
                self,
                "Success",
                f"Configuration saved successfully with {len(self.monitored_services)} monitored services!\n\n"
                "Unitray has automatically applied the changes to your system tray.",
            )
            self.accept()
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to save configuration:\n{e}")


def main():
    app = QApplication(sys.argv)
    window = UnitraySettingsWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
