#!/usr/bin/env python3
"""
Unitray Settings - Native Qt 6 Graphical Configuration Utility for Unitray
Uses native Qt 6 Breeze style, fully integrated with KDE Plasma & Wayland.
"""

import sys
import tomllib
from pathlib import Path

from PySide6.QtCore import Qt
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication,
    QDialog,
    QVBoxLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QTableWidget,
    QTableWidgetItem,
    QHeaderView,
    QSpinBox,
    QLineEdit,
    QGroupBox,
    QFormLayout,
    QMessageBox,
    QInputDialog,
)

CONFIG_DIR = Path.home() / ".config" / "unitray"
CONFIG_PATH = CONFIG_DIR / "config.toml"

DEFAULT_CONFIG = {
    "refresh_interval_secs": 3,
    "tray_icon": "preferences-system-services",
    "services": [
        {"name": "MariaDB", "unit": "mariadb.service"},
        {"name": "PostgreSQL", "unit": "postgresql.service"},
        {"name": "Docker", "unit": "docker.service"},
        {"name": "Cloudflare Tunnel", "unit": "cloudflared.service"},
    ],
}


def load_config():
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "rb") as f:
                data = tomllib.load(f)
                return {
                    "refresh_interval_secs": data.get("refresh_interval_secs", 3),
                    "tray_icon": data.get("tray_icon", "preferences-system-services"),
                    "services": data.get("services", []),
                }
        except Exception as e:
            QMessageBox.warning(None, "Warning", f"Failed to parse config, using defaults:\n{e}")
    return DEFAULT_CONFIG.copy()


def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Unitray Configuration",
        "# Auto-generated by Unitray Settings",
        "",
        f"refresh_interval_secs = {int(config['refresh_interval_secs'])}",
        f'tray_icon = "{config["tray_icon"].strip()}"',
        "",
    ]
    for s in config["services"]:
        lines.append("[[services]]")
        lines.append(f'name = "{s["name"].strip()}"')
        lines.append(f'unit = "{s["unit"].strip()}"')
        lines.append("")

    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


class ServiceEditDialog(QDialog):
    def __init__(self, parent=None, title="Add Service", name="", unit=""):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setMinimumWidth(360)

        layout = QVBoxLayout(self)

        form = QFormLayout()
        self.name_edit = QLineEdit(name)
        self.name_edit.setPlaceholderText("e.g. Redis")
        form.addRow("Display Name:", self.name_edit)

        self.unit_edit = QLineEdit(unit or ".service")
        self.unit_edit.setPlaceholderText("e.g. redis.service")
        form.addRow("systemd Unit:", self.unit_edit)

        layout.addLayout(form)

        btn_box = QHBoxLayout()
        btn_box.addStretch()

        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        btn_box.addWidget(cancel_btn)

        save_btn = QPushButton("Save")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self.validate_and_accept)
        btn_box.addWidget(save_btn)

        layout.addLayout(btn_box)

    def validate_and_accept(self):
        name = self.name_edit.text().strip()
        unit = self.unit_edit.text().strip()

        if not name:
            QMessageBox.warning(self, "Invalid Input", "Please enter a display name.")
            return
        if not unit or unit == ".service":
            QMessageBox.warning(self, "Invalid Input", "Please enter a valid systemd unit name.")
            return

        if not any(unit.endswith(ext) for ext in [".service", ".socket", ".target", ".timer"]):
            unit = f"{unit}.service"

        self.name = name
        self.unit = unit
        self.accept()


class UnitraySettingsWindow(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Unitray Settings")
        self.setWindowIcon(QIcon.fromTheme("preferences-system-services"))
        self.resize(520, 520)

        self.config_data = load_config()

        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        # Header Info
        header = QLabel("<h3>Unitray Settings</h3>")
        layout.addWidget(header)

        # Services Section
        services_group = QGroupBox("Monitored systemd Services")
        serv_layout = QVBoxLayout(services_group)

        self.table = QTableWidget(0, 2)
        self.table.setHorizontalHeaderLabels(["Display Name", "systemd Unit Name"])
        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.Stretch)
        self.table.setSelectionBehavior(QTableWidget.SelectRows)
        self.table.setSelectionMode(QTableWidget.SingleSelection)
        self.table.setAlternatingRowColors(True)
        serv_layout.addWidget(self.table)

        # Table Action Buttons
        btn_row = QHBoxLayout()

        add_btn = QPushButton(QIcon.fromTheme("list-add"), "Add")
        add_btn.clicked.connect(self.add_service)
        btn_row.addWidget(add_btn)

        edit_btn = QPushButton(QIcon.fromTheme("edit-entry"), "Edit")
        edit_btn.clicked.connect(self.edit_service)
        btn_row.addWidget(edit_btn)

        remove_btn = QPushButton(QIcon.fromTheme("list-remove"), "Remove")
        remove_btn.clicked.connect(self.remove_service)
        btn_row.addWidget(remove_btn)

        btn_row.addStretch()

        up_btn = QPushButton(QIcon.fromTheme("go-up"), "Up")
        up_btn.clicked.connect(self.move_up)
        btn_row.addWidget(up_btn)

        down_btn = QPushButton(QIcon.fromTheme("go-down"), "Down")
        down_btn.clicked.connect(self.move_down)
        btn_row.addWidget(down_btn)

        serv_layout.addLayout(btn_row)
        layout.addWidget(services_group)

        # General Options Section
        opts_group = QGroupBox("General Options")
        form_layout = QFormLayout(opts_group)

        self.interval_spin = QSpinBox()
        self.interval_spin.setRange(1, 60)
        self.interval_spin.setSuffix(" seconds")
        self.interval_spin.setValue(self.config_data.get("refresh_interval_secs", 3))
        form_layout.addRow("Polling Interval:", self.interval_spin)

        self.icon_edit = QLineEdit(self.config_data.get("tray_icon", "preferences-system-services"))
        form_layout.addRow("Tray Icon Theme Name:", self.icon_edit)

        layout.addWidget(opts_group)

        # Bottom Buttons
        bottom_bar = QHBoxLayout()

        editor_btn = QPushButton(QIcon.fromTheme("document-edit"), "Open Config File...")
        editor_btn.clicked.connect(self.open_in_editor)
        bottom_bar.addWidget(editor_btn)

        bottom_bar.addStretch()

        cancel_btn = QPushButton("Cancel")
        cancel_btn.clicked.connect(self.reject)
        bottom_bar.addWidget(cancel_btn)

        save_btn = QPushButton(QIcon.fromTheme("dialog-ok-apply"), "Save & Apply")
        save_btn.setDefault(True)
        save_btn.clicked.connect(self.save_and_apply)
        bottom_bar.addWidget(save_btn)

        layout.addLayout(bottom_bar)

        self.populate_services()

    def populate_services(self):
        self.table.setRowCount(0)
        for s in self.config_data.get("services", []):
            row = self.table.rowCount()
            self.table.insertRow(row)
            self.table.setItem(row, 0, QTableWidgetItem(s.get("name", "")))
            self.table.setItem(row, 1, QTableWidgetItem(s.get("unit", "")))

    def add_service(self):
        dlg = ServiceEditDialog(self, title="Add New Service")
        if dlg.exec() == QDialog.Accepted:
            row = self.table.rowCount()
            self.table.insertRow(row)
            self.table.setItem(row, 0, QTableWidgetItem(dlg.name))
            self.table.setItem(row, 1, QTableWidgetItem(dlg.unit))

    def edit_service(self):
        row = self.table.currentRow()
        if row < 0:
            QMessageBox.information(self, "Notice", "Please select a service to edit.")
            return
        name = self.table.item(row, 0).text()
        unit = self.table.item(row, 1).text()

        dlg = ServiceEditDialog(self, title="Edit Service", name=name, unit=unit)
        if dlg.exec() == QDialog.Accepted:
            self.table.setItem(row, 0, QTableWidgetItem(dlg.name))
            self.table.setItem(row, 1, QTableWidgetItem(dlg.unit))

    def remove_service(self):
        row = self.table.currentRow()
        if row < 0:
            QMessageBox.information(self, "Notice", "Please select a service to remove.")
            return
        name = self.table.item(row, 0).text()
        reply = QMessageBox.question(
            self,
            "Confirm Remove",
            f"Remove '{name}' from monitored services?",
            QMessageBox.Yes | QMessageBox.No,
        )
        if reply == QMessageBox.Yes:
            self.table.removeRow(row)

    def move_up(self):
        row = self.table.currentRow()
        if row > 0:
            self.swap_rows(row, row - 1)
            self.table.selectRow(row - 1)

    def move_down(self):
        row = self.table.currentRow()
        if 0 <= row < self.table.rowCount() - 1:
            self.swap_rows(row, row + 1)
            self.table.selectRow(row + 1)

    def swap_rows(self, r1, r2):
        name1 = self.table.item(r1, 0).text()
        unit1 = self.table.item(r1, 1).text()
        name2 = self.table.item(r2, 0).text()
        unit2 = self.table.item(r2, 1).text()

        self.table.setItem(r1, 0, QTableWidgetItem(name2))
        self.table.setItem(r1, 1, QTableWidgetItem(unit2))
        self.table.setItem(r2, 0, QTableWidgetItem(name1))
        self.table.setItem(r2, 1, QTableWidgetItem(unit1))

    def open_in_editor(self):
        import os
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if not CONFIG_PATH.exists():
            save_config(self.config_data)
        os.system(f"xdg-open '{CONFIG_PATH}' &")

    def save_and_apply(self):
        services = []
        for r in range(self.table.rowCount()):
            name = self.table.item(r, 0).text().strip()
            unit = self.table.item(r, 1).text().strip()
            if name and unit:
                services.append({"name": name, "unit": unit})

        new_config = {
            "refresh_interval_secs": self.interval_spin.value(),
            "tray_icon": self.icon_edit.text().strip() or "preferences-system-services",
            "services": services,
        }

        try:
            save_config(new_config)
            QMessageBox.information(
                self,
                "Success",
                "Configuration saved successfully!\nUnitray has automatically applied the new settings.",
            )
            self.accept()
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to save configuration:\n{e}")


def main():
    app = QApplication(sys.argv)
    window = UnitraySettingsWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
