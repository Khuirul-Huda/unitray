#!/usr/bin/env python3
"""
Unitray Settings - Graphical Configuration Utility for Unitray
"""

import os
import sys
import tomllib
from pathlib import Path
import tkinter as tk
from tkinter import ttk, messagebox, simpledialog

CONFIG_DIR = Path.home() / ".config" / "unitray"
CONFIG_PATH = CONFIG_DIR / "config.toml"

DEFAULT_CONFIG = {
    "refresh_interval_secs": 3,
    "tray_icon": "preferences-system-services",
    "services": [
        {"name": "MariaDB", "unit": "mariadb.service"},
        {"name": "PostgreSQL", "unit": "postgresql.service"},
        {"name": "Docker", "unit": "docker.service"},
        {"name": "Cloudflare Tunnel", "unit": "cloudflared.service"},
    ],
}


def load_config():
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "rb") as f:
                data = tomllib.load(f)
                return {
                    "refresh_interval_secs": data.get("refresh_interval_secs", 3),
                    "tray_icon": data.get("tray_icon", "preferences-system-services"),
                    "services": data.get("services", []),
                }
        except Exception as e:
            messagebox.showwarning("Warning", f"Failed to parse config, using defaults:\n{e}")
    return DEFAULT_CONFIG.copy()


def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Unitray Configuration",
        "# Auto-generated by Unitray Settings",
        "",
        f"refresh_interval_secs = {int(config['refresh_interval_secs'])}",
        f'tray_icon = "{config["tray_icon"].strip()}"',
        "",
    ]
    for s in config["services"]:
        lines.append("[[services]]")
        lines.append(f'name = "{s["name"].strip()}"')
        lines.append(f'unit = "{s["unit"].strip()}"')
        lines.append("")

    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))


class ServiceDialog(tk.Toplevel):
    def __init__(self, parent, title="Add Service", name="", unit=""):
        super().__init__(parent)
        self.title(title)
        self.resizable(False, False)
        self.transient(parent)
        self.grab_set()

        self.result = None

        frame = ttk.Frame(self, padding=16)
        frame.pack(fill="both", expand=True)

        ttk.Label(frame, text="Display Name:", font=("sans-serif", 10, "bold")).grid(
            row=0, column=0, sticky="w", pady=(0, 4)
        )
        self.name_entry = ttk.Entry(frame, width=32)
        self.name_entry.insert(0, name)
        self.name_entry.grid(row=1, column=0, columnspan=2, sticky="ew", pady=(0, 12))

        ttk.Label(frame, text="systemd Unit Name:", font=("sans-serif", 10, "bold")).grid(
            row=2, column=0, sticky="w", pady=(0, 4)
        )
        self.unit_entry = ttk.Entry(frame, width=32)
        self.unit_entry.insert(0, unit or ".service")
        self.unit_entry.grid(row=3, column=0, columnspan=2, sticky="ew", pady=(0, 16))

        btn_box = ttk.Frame(frame)
        btn_box.grid(row=4, column=0, columnspan=2, sticky="e")

        ttk.Button(btn_box, text="Cancel", command=self.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(btn_box, text="Save", command=self.on_save).pack(side="right")

        self.name_entry.focus_set()
        self.bind("<Return>", lambda e: self.on_save())
        self.bind("<Escape>", lambda e: self.destroy())

    def on_save(self):
        name = self.name_entry.get().strip()
        unit = self.unit_entry.get().strip()

        if not name:
            messagebox.showerror("Error", "Please enter a display name.", parent=self)
            return
        if not unit:
            messagebox.showerror("Error", "Please enter a systemd unit name.", parent=self)
            return

        if not unit.endswith(".service") and not unit.endswith(".socket") and not unit.endswith(".target"):
            unit = f"{unit}.service"

        self.result = {"name": name, "unit": unit}
        self.destroy()


class UnitraySettingsApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Unitray Settings")
        self.geometry("520x560")
        self.minsize(460, 480)

        # Style configuration
        self.style = ttk.Style(self)
        try:
            self.style.theme_use("clam")
        except Exception:
            pass

        self.config_data = load_config()

        self.create_widgets()
        self.populate_data()

    def create_widgets(self):
        container = ttk.Frame(self, padding=16)
        container.pack(fill="both", expand=True)

        # Header
        header = ttk.Label(
            container,
            text="Unitray Configuration",
            font=("sans-serif", 14, "bold"),
        )
        header.pack(anchor="w", pady=(0, 4))

        subtext = ttk.Label(
            container,
            text=f"Managing: {CONFIG_PATH}",
            font=("sans-serif", 8),
            foreground="#666666",
        )
        subtext.pack(anchor="w", pady=(0, 16))

        # Services Section
        sec_label = ttk.Label(container, text="Monitored Services", font=("sans-serif", 10, "bold"))
        sec_label.pack(anchor="w", pady=(0, 6))

        list_frame = ttk.Frame(container)
        list_frame.pack(fill="both", expand=True, pady=(0, 8))

        columns = ("name", "unit")
        self.tree = ttk.Treeview(list_frame, columns=columns, show="headings", selectmode="browse")
        self.tree.heading("name", text="Service Name")
        self.tree.heading("unit", text="systemd Unit")
        self.tree.column("name", width=180, anchor="w")
        self.tree.column("unit", width=240, anchor="w")

        scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)

        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # Service Action Buttons
        btn_bar = ttk.Frame(container)
        btn_bar.pack(fill="x", pady=(0, 16))

        ttk.Button(btn_bar, text="➕ Add", command=self.add_service).pack(side="left", padx=(0, 6))
        ttk.Button(btn_bar, text="✏️ Edit", command=self.edit_service).pack(side="left", padx=(0, 6))
        ttk.Button(btn_bar, text="🗑️ Remove", command=self.remove_service).pack(side="left", padx=(0, 6))
        ttk.Button(btn_bar, text="⬇️ Down", command=self.move_down).pack(side="right", padx=(6, 0))
        ttk.Button(btn_bar, text="⬆️ Up", command=self.move_up).pack(side="right")

        # General Options Frame
        opt_frame = ttk.LabelFrame(container, text="General Options", padding=12)
        opt_frame.pack(fill="x", pady=(0, 16))

        # Refresh interval
        ttk.Label(opt_frame, text="Refresh Interval (seconds):").grid(row=0, column=0, sticky="w", pady=4)
        self.interval_spin = ttk.Spinbox(opt_frame, from_=1, to=60, width=8)
        self.interval_spin.grid(row=0, column=1, sticky="w", padx=8, pady=4)

        # Tray Icon
        ttk.Label(opt_frame, text="Tray Icon Theme Name:").grid(row=1, column=0, sticky="w", pady=4)
        self.icon_entry = ttk.Entry(opt_frame, width=28)
        self.icon_entry.grid(row=1, column=1, sticky="w", padx=8, pady=4)

        # Footer Action Buttons
        footer = ttk.Frame(container)
        footer.pack(fill="x", side="bottom")

        ttk.Button(footer, text="Open in Text Editor", command=self.open_in_editor).pack(side="left")
        ttk.Button(footer, text="Cancel", command=self.destroy).pack(side="right", padx=(8, 0))
        ttk.Button(footer, text="💾 Save & Apply", command=self.save_and_exit).pack(side="right")

    def populate_data(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        for s in self.config_data.get("services", []):
            self.tree.insert("", "end", values=(s.get("name", ""), s.get("unit", "")))

        self.interval_spin.set(str(self.config_data.get("refresh_interval_secs", 3)))
        self.icon_entry.delete(0, "end")
        self.icon_entry.insert(0, self.config_data.get("tray_icon", "preferences-system-services"))

    def add_service(self):
        dlg = ServiceDialog(self, title="Add Service")
        self.wait_window(dlg)
        if dlg.result:
            self.tree.insert("", "end", values=(dlg.result["name"], dlg.result["unit"]))

    def edit_service(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showinfo("Notice", "Please select a service from the list to edit.")
            return

        item = selected[0]
        name, unit = self.tree.item(item, "values")
        dlg = ServiceDialog(self, title="Edit Service", name=name, unit=unit)
        self.wait_window(dlg)
        if dlg.result:
            self.tree.item(item, values=(dlg.result["name"], dlg.result["unit"]))

    def remove_service(self):
        selected = self.tree.selection()
        if not selected:
            messagebox.showinfo("Notice", "Please select a service from the list to remove.")
            return

        item = selected[0]
        name = self.tree.item(item, "values")[0]
        if messagebox.askyesno("Confirm", f"Remove '{name}' from monitored services?"):
            self.tree.delete(item)

    def move_up(self):
        selected = self.tree.selection()
        if not selected:
            return
        item = selected[0]
        idx = self.tree.index(item)
        if idx > 0:
            self.tree.move(item, "", idx - 1)

    def move_down(self):
        selected = self.tree.selection()
        if not selected:
            return
        item = selected[0]
        idx = self.tree.index(item)
        total = len(self.tree.get_children())
        if idx < total - 1:
            self.tree.move(item, "", idx + 1)

    def open_in_editor(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if not CONFIG_PATH.exists():
            save_config(self.config_data)
        os.system(f"xdg-open '{CONFIG_PATH}' &")

    def save_and_exit(self):
        services = []
        for item in self.tree.get_children():
            name, unit = self.tree.item(item, "values")
            services.append({"name": name, "unit": unit})

        try:
            interval = int(self.interval_spin.get())
            if interval < 1:
                interval = 1
        except ValueError:
            interval = 3

        tray_icon = self.icon_entry.get().strip() or "preferences-system-services"

        new_config = {
            "refresh_interval_secs": interval,
            "tray_icon": tray_icon,
            "services": services,
        }

        try:
            save_config(new_config)
            messagebox.showinfo("Success", "Settings saved successfully! Unitray will automatically update.")
            self.destroy()
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save configuration:\n{e}")


def main():
    app = UnitraySettingsApp()
    app.mainloop()


if __name__ == "__main__":
    main()
