/* Polkit rules for Unitray to manage developer systemd services without password prompt */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.isInGroup("wheel")) {
        var verb = action.lookup("verb");
        var unit = action.lookup("unit");
        var allowedVerbs = ["start", "stop", "restart"];
        var devUnits = [
            "mariadb.service",
            "postgresql.service",
            "docker.service",
            "cloudflared.service",
            "redis.service",
            "nginx.service",
            "httpd.service",
            "mongodb.service"
        ];
        if (allowedVerbs.indexOf(verb) !== -1 && devUnits.indexOf(unit) !== -1) {
            return polkit.Result.YES;
        }
    }
});
